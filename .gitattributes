# Normalise line endings so the repository is identical on Windows, macOS and
# Linux, and so `git diff` never reports a whole file as changed after a
# checkout on a different platform.
* text=auto eol=lf

# Windows-only tooling files that Unity and Visual Studio rewrite with CRLF.
*.sln           text eol=crlf
*.csproj        text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary assets: never normalise, never diff as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.psd           binary
*.ttf           binary
*.otf           binary
*.dll           binary
*.so            binary
*.a             binary
*.bytes         binary
*.fui           binary
*.unitypackage  binary

# Unity YAML. Merging these by hand is a losing game; mark them so a merge
# conflict is reported rather than silently interleaved. Enable Unity's
# SmartMerge (UnityYAMLMerge) locally to actually resolve them.
*.unity         merge=unityyamlmerge eol=lf
*.prefab        merge=unityyamlmerge eol=lf
*.asset         merge=unityyamlmerge eol=lf
*.mat           merge=unityyamlmerge eol=lf
*.controller    merge=unityyamlmerge eol=lf
